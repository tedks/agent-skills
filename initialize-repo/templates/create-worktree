#!/usr/bin/env bash

# Create or reuse a sibling worktree for the given branch, using the central
# bare repository located at .git in the directory containing this script.
#
# Expected project layout (this script lives at the project root):
#   ~/Projects/<project>/
#   ├── .git/                    # bare repo
#   ├── create-worktree          # this script
#   ├── master/                  # primary worktree (master or main)
#   └── <project>-<branch>/      # feature worktrees created by this script
#
# Environment overrides:
#   REMOTE    Remote URL. Defaults to the bare repo's origin URL; only
#             required when the bare repo does not exist yet (first run).
#   BASE_REF  Base reference for new branches. Defaults to origin/master,
#             falling back to origin/main.

set -euo pipefail

usage() {
  echo "Usage: $(basename "$0") <branch>" >&2
  exit 1
}

find_primary_worktree() {
  # Prefer the worktree on master, then main; otherwise use the first listed
  # worktree (excluding the bare repo itself).
  local primary path
  for primary in master main; do
    path="$(git --git-dir="$GIT_DIR" worktree list --porcelain 2>/dev/null | awk -v ref="refs/heads/$primary" '$1=="worktree"{p=$2} $1=="branch" && $2==ref{print p}')"
    if [[ -n "$path" ]]; then
      echo "$path"
      return
    fi
  done
  git --git-dir="$GIT_DIR" worktree list --porcelain 2>/dev/null | awk 'NR==1{next} $1=="worktree"{print $2; exit}'
}

setup_beads_redirect() {
  local canonical_worktree
  canonical_worktree="$(find_primary_worktree)"
  if [[ -z "$canonical_worktree" ]]; then
    echo "[beads][warn] No primary worktree found; skipping redirect setup."
    return 0
  fi
  if [[ "$canonical_worktree" == "$WORKTREE_DIR" ]]; then
    echo "[beads] This worktree is the primary worktree; no redirect needed."
    return 0
  fi

  local canonical_beads_dir="$canonical_worktree/.beads"
  local worktree_beads_dir="$WORKTREE_DIR/.beads"
  local redirect_file="$worktree_beads_dir/redirect"

  mkdir -p "$canonical_beads_dir" "$worktree_beads_dir"

  if [[ -f "$redirect_file" ]]; then
    echo "[beads] Redirect already present: $redirect_file"
    return 0
  fi

  local target_ref="$canonical_beads_dir"
  if command -v realpath >/dev/null 2>&1; then
    target_ref="$(realpath --relative-to="$worktree_beads_dir" "$canonical_beads_dir" 2>/dev/null || echo "$canonical_beads_dir")"
  elif command -v python3 >/dev/null 2>&1; then
    target_ref="$(
      python3 -c 'import os,sys; print(os.path.relpath(sys.argv[1], sys.argv[2]))' \
        "$canonical_beads_dir" \
        "$worktree_beads_dir"
    )"
  fi

  printf '%s\n' "$target_ref" >"$redirect_file"
  echo "[beads] Configured redirect: $redirect_file -> $target_ref"
}

BRANCH="${1:-}"
[ -n "$BRANCH" ] || usage

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GIT_DIR="$ROOT/.git"
PROJECT="$(basename "$ROOT")"
case "$BRANCH" in
  master|main) WORKTREE_DIR="$ROOT/$BRANCH" ;;          # primary worktree
  *)           WORKTREE_DIR="$ROOT/$PROJECT-$BRANCH" ;; # feature worktrees
esac

# Ensure the central bare repo exists.
if [ -d "$GIT_DIR" ]; then
  if ! git --git-dir="$GIT_DIR" rev-parse --is-bare-repository >/dev/null 2>&1; then
    echo "$GIT_DIR exists but is not a valid git repository. Aborting." >&2
    exit 1
  fi
  REMOTE="${REMOTE:-$(git --git-dir="$GIT_DIR" remote get-url origin 2>/dev/null || true)}"
else
  if [ -z "${REMOTE:-}" ]; then
    echo "No bare repository at $GIT_DIR and REMOTE is not set." >&2
    echo "First run: REMOTE=git@github.com:<user>/<repo>.git $(basename "$0") <branch>" >&2
    exit 1
  fi
  echo "Creating bare repository in $GIT_DIR..."
  git clone --bare "$REMOTE" "$GIT_DIR"
fi

# Make sure the remote is set correctly (in case the bare repo pre-existed).
if [ -n "${REMOTE:-}" ]; then
  if git --git-dir="$GIT_DIR" remote get-url origin >/dev/null 2>&1; then
    git --git-dir="$GIT_DIR" remote set-url origin "$REMOTE"
  else
    git --git-dir="$GIT_DIR" remote add origin "$REMOTE"
  fi
fi

# Ensure a fetch refspec exists (handles older bare clones without one).
if ! git --git-dir="$GIT_DIR" config --get-all remote.origin.fetch >/dev/null 2>&1; then
  git --git-dir="$GIT_DIR" config remote.origin.fetch "+refs/heads/*:refs/remotes/origin/*"
fi

# Stay up to date.
git --git-dir="$GIT_DIR" fetch origin --prune

# Pick the base reference for new branches: origin/master, then origin/main.
if [ -z "${BASE_REF:-}" ]; then
  for candidate in origin/master origin/main; do
    if git --git-dir="$GIT_DIR" rev-parse --verify --quiet "refs/remotes/$candidate" >/dev/null; then
      BASE_REF="$candidate"
      break
    fi
  done
fi
if [ -z "${BASE_REF:-}" ]; then
  echo "Could not find origin/master or origin/main; set BASE_REF explicitly." >&2
  exit 1
fi

echo "Using GIT_DIR:    $GIT_DIR"
echo "Branch:           $BRANCH"
echo "Worktree path:    $WORKTREE_DIR"
echo "Base reference:   $BASE_REF"
echo "Remote:           ${REMOTE:-<none configured>}"

# Ensure the branch exists locally.
if git --git-dir="$GIT_DIR" show-ref --verify --quiet "refs/heads/$BRANCH"; then
  :
elif git --git-dir="$GIT_DIR" ls-remote --exit-code origin "refs/heads/$BRANCH" >/dev/null 2>&1; then
  git --git-dir="$GIT_DIR" branch --track "$BRANCH" "origin/$BRANCH"
else
  git --git-dir="$GIT_DIR" branch "$BRANCH" "$BASE_REF"
fi

# Avoid checking out a branch already in use.
if git --git-dir="$GIT_DIR" worktree list --porcelain | awk '$1=="branch"{print $2}' | grep -Fx "refs/heads/$BRANCH" >/dev/null; then
  echo "Branch $BRANCH is already checked out in another worktree. Reuse it or pick a new branch name." >&2
  exit 1
fi

# Add the worktree if needed.
if git --git-dir="$GIT_DIR" worktree list --porcelain | awk '$1=="worktree"{print $2}' | grep -Fx "$WORKTREE_DIR" >/dev/null; then
  echo "Worktree already registered at $WORKTREE_DIR."
elif [ -e "$WORKTREE_DIR" ]; then
  echo "Path $WORKTREE_DIR exists but is not registered as a worktree. Aborting to avoid overwriting." >&2
  exit 1
else
  echo "Adding worktree at $WORKTREE_DIR..."
  git --git-dir="$GIT_DIR" worktree add "$WORKTREE_DIR" "$BRANCH"
fi

echo
setup_beads_redirect

echo
echo "Active worktrees:"
git --git-dir="$GIT_DIR" worktree list
